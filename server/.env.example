# Copy to .env and adjust
DATABASE_URL="postgresql://pdash:pdash@localhost:5432/pdash?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seed bootstrap accounts (created by `npm run seed`)
SEED_ADMIN_EMAIL="admin@acme.com"
SEED_VP_EMAIL="vp@acme.com"
SEED_VP_PASSWORD="Passw0rd!"

# Weekly digest — off by default; no credentials needed to leave it off.
DIGEST_ENABLED="false"
DIGEST_CRON="0 8 * * 1"
DIGEST_TIMEZONE="UTC"
# "file" (default, writes to OUTBOX_DIR) or "smtp"
DIGEST_ADAPTER="file"
OUTBOX_DIR="outbox"

# Only read when DIGEST_ADAPTER="smtp"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Project Dashboard <digest@localhost>"
